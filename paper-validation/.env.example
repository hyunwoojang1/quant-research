# ─────────────────────────────────────────────────────────────
# quant-research 환경변수 템플릿
# 사용법: 이 파일을 복사해서 .env 로 이름 변경 후 실제 값 채우기
#   cp .env.example .env
# .env 는 .gitignore 에 의해 커밋되지 않습니다. 절대 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────

# ── FRED (세인트루이스 연준 매크로 데이터) ──
# 무료 발급: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# ── WRDS (CRSP / Compustat / OptionMetrics / TAQ) ──
# 권장: 비밀번호는 .env 대신 ~/.pgpass 에 두는 것이 안전합니다.
#   ~/.pgpass 형식:  wrds-pgdata.wharton.upenn.edu:9737:wrds:<USERNAME>:<PASSWORD>
#   chmod 600 ~/.pgpass
# 아래에 비밀번호를 넣으면 .pgpass 없이도 동작하지만, 보안상 .pgpass 를 권장합니다.
WRDS_USERNAME=
WRDS_PASSWORD=
WRDS_HOSTNAME=wrds-pgdata.wharton.upenn.edu
WRDS_PORT=9737
WRDS_DBNAME=wrds

# ── 무료 금융 데이터 API 키 (WRDS 미사용 기간 대안) ──
# 1순위(추천): Tiingo — 무료 30년+ 수정주가, 시간당 50/일 1,000/월 500종목.
#   발급: https://www.tiingo.com  → 가입 → Account → API → Token 복사
TIINGO_API_KEY=
# 2순위: Financial Modeling Prep — 재무제표/펀더멘털, 일 250회.
#   발급: https://site.financialmodelingprep.com/developer/docs
#   주의: 2025-08-31 이후 신규 키는 'stable' 엔드포인트만 동작(legacy v3 폐지).
#         예) https://financialmodelingprep.com/stable/historical-price-eod/full?symbol=AAPL&apikey=KEY
#         가격은 수정주가가 아니므로(원시 close), 가격 재현은 Tiingo, FMP 는 펀더멘털 용도.
FMP_API_KEY=
# 3순위: Finnhub — 실시간/펀더멘털, 분당 60회.
#   발급: https://finnhub.io/register
FINNHUB_API_KEY=

# ── 데이터 소스 우선순위 ──
# auto  : TIINGO_API_KEY 있으면 Tiingo, 없으면 yfinance (권장)
# wrds  : 학기중 WRDS/CRSP 사용 가능할 때
# 가능한 값: auto | wrds | tiingo | yfinance
PRIMARY_EQUITY_SOURCE=auto
